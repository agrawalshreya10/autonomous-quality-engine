# Smoke-only env for Docker (`docker run --env-file .env.smoke`).
# Copy to repo-root `.env.smoke` and adjust. Do not put AI keys here —
# use `.env` / config/env.example for local AI audit (GEMINI_API_KEY, Ollama).

# Base URL (Defaults to public demo if unset)
BASE_URL=https://opensource-demo.orangehrmlive.com

# Safe default (matches config/settings.py when unset)
IGNORE_HTTPS_ERRORS=false

# Execution Settings
BROWSER=chromium
HEADLESS=true
TIMEOUT_MS=15000

# Credentials (Defaults match public demo; override for your instance)
ORANGEHRM_USER=Admin
ORANGEHRM_PASSWORD=admin123
